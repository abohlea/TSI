  "dependencies": {
    "@capacitor/android": "7.4.3",
    "@capacitor/core": "7.4.3",
    "@colyseus/sdk": "0.18.9",
    "firebase": "13.2.0",
    "playcanvas": "2.23.3"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.3",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
