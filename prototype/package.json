{
  "name": "tsi-field-test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TSI — PlayCanvas mobile-first combat prototype",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
