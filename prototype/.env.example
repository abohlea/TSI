# Copy to .env.local for a local-only connection to backend/realtime.
# The token must match backend/realtime/.env and must never be reused in production.
VITE_TSI_SERVER_URL=http://localhost:2567
VITE_TSI_LOCAL_DEV_TOKEN=replace-with-the-same-local-token-of-at-least-24-characters

# Firebase Web App configuration (public client values; never put Admin credentials here).
# For local Auth Emulator testing, set VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id

# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Optional local avatar upload API (requires Cloudinary server credentials).
VITE_TSI_MEDIA_API_URL=http://localhost:2568
