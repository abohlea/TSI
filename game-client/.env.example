# Firebase Web App configuration (public client values; never put service-account keys here).
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-tsi-local.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-tsi-local
VITE_FIREBASE_APP_ID=1:123456789:web:0000000000000000

# Local Emulator Suite. Leave this blank when connecting to your configured Firebase project.
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Local Colyseus and signed media APIs
VITE_TSI_SERVER_URL=http://127.0.0.1:2567
VITE_TSI_MEDIA_API_URL=http://127.0.0.1:2568
VITE_TSI_DISPLAY_NAME=OPERATOR
