# Optional local Colyseus connection. Leave empty to use offline target practice.
VITE_TSI_LOCAL_SERVER_URL=http://127.0.0.1:2567
# LOCAL DEVELOPMENT ONLY. The browser receives this token; never use it on an internet-facing server.
VITE_TSI_LOCAL_DEV_TOKEN=replace-with-the-same-local-token-used-by-server
VITE_TSI_LOCAL_DISPLAY_NAME=OPERATOR
