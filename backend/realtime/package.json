{
  "name": "tsi-realtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TSI local authoritative session server prototype",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file=.env --import=tsx --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "colyseus": "0.18.10",
    "@colyseus/schema": "5.0.44"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.6",
    "typescript": "7.0.2"
  }
}
