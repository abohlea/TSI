# Local-only testing. This server MUST refuse these tickets in production.
NODE_ENV=development
PORT=2567
TSI_ENABLE_LOCAL_AUTH=true
TSI_LOCAL_DEV_TOKEN=replace-with-a-long-random-local-only-token

# Production only: Firebase project and server-side Application Default Credentials.
# Never put service-account private keys in this file or the repository.
# FIREBASE_PROJECT_ID=your-firebase-project-id
# TSI_SESSION_TICKET_SECRET=generate-at-least-32-random-characters-and-store-as-a-secret
