# Local-only testing. This server MUST refuse these tickets in production.
NODE_ENV=development
PORT=2567
TSI_ENABLE_LOCAL_AUTH=true
TSI_LOCAL_DEV_TOKEN=replace-with-a-long-random-local-only-token

# Optional local Firebase Emulator flow (same project ID in prototype/.env.local).
# FIREBASE_PROJECT_ID=demo-tsi
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# TSI_SESSION_TICKET_SECRET=local-only-random-secret-with-at-least-32-characters
# TSI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production: real Firebase project and server-side ADC/workload identity.
# Never put service-account private keys in this file or the repository.
# FIREBASE_PROJECT_ID=your-firebase-project-id
# TSI_SESSION_TICKET_SECRET=generate-at-least-32-random-characters-and-store-as-a-secret
# TSI_ALLOWED_ORIGINS=https://your-game-domain.example

# Optional local Cloudinary avatar service. Leave blank to disable it.
# Configure a signed upload preset restricted to jpg/jpeg/png/webp.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_UPLOAD_PRESET=
# TSI_MEDIA_API_PORT=2568
# TSI_MEDIA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
