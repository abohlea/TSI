rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // The user account document is private and is written only by trusted services.
    match /users/{uid} {
      allow get: if owns(uid);
      allow list, create, update, delete: if false;
    }

    // Only public presentation fields may live in playerProfiles.
    // Never put email addresses, private settings, tokens or moderation notes here.
    match /playerProfiles/{uid} {
      allow get: if signedIn();
      allow list, create, update, delete: if false;
    }

    // Inventory and progression are readable by their owner; grants and mutations
    // are performed only by the trusted backend after server-verified events.
    match /inventories/{uid}/items/{itemId} {
      allow read: if owns(uid);
      allow write: if false;
    }

    match /progression/{uid} {
      allow read: if owns(uid);
      allow write: if false;
    }

    // A match summary must contain participantUids. A query must constrain by
    // participantUids so that rules are not incorrectly treated as query filters.
    match /matchSummaries/{matchId} {
      allow get: if signedIn() &&
        resource.data.participantUids is list &&
        request.auth.uid in resource.data.participantUids;
      allow list: if signedIn() &&
        resource.data.participantUids.hasAny([request.auth.uid]);
      allow create, update, delete: if false;
    }

    // Season configuration is public to authenticated clients but immutable from clients.
    match /seasons/{seasonId} {
      allow get, list: if signedIn();
      allow create, update, delete: if false;
    }

    // Reports and audit data are private to trusted moderation/admin services.
    match /reports/{reportId} {
      allow read, write: if false;
    }

    match /auditEvents/{eventId} {
      allow read, write: if false;
    }

    // Default deny: new collections remain closed until explicitly reviewed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
