rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isConversationMember(conversationId) {
      return signedIn()
        && request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(conversationId)
        ).data.memberIds;
    }

    match /users/{userId} {
      // Profiles are discoverable by authenticated TSI members.
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.keys().hasOnly([
          "uid", "displayName", "photoURL", "about", "phoneNumber",
          "createdAt", "updatedAt"
        ]);
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "displayName", "photoURL", "about", "phoneNumber", "updatedAt"
        ]);
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() >= 2
        && request.resource.data.memberIds.size() <= 100
        && request.resource.data.lastMessage is string
        && request.resource.data.keys().hasOnly([
          "memberIds", "title", "createdAt", "lastMessageAt", "lastMessage"
        ]);
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "lastMessage", "lastMessageAt"
        ])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 10000;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConversationMember(conversationId);
        allow create: if isConversationMember(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.type in ["text", "image", "video", "file", "audio"]
          && request.resource.data.createdAt is timestamp
          && (
            (request.resource.data.type == "text"
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 10000
              && request.resource.data.keys().hasOnly([
                "senderId", "text", "type", "createdAt"
              ]))
            ||
            (request.resource.data.type in ["image", "video", "file", "audio"]
              && request.resource.data.text == ""
              && request.resource.data.mediaUrl is string
              && request.resource.data.mediaUrl.matches("https://.*")
              && request.resource.data.keys().hasOnly([
                "senderId", "text", "type", "mediaUrl", "mediaName", "createdAt"
              ]))
          );
        allow update, delete: if false;
      }
    }
  }
}
