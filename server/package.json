{
  "name": "tsi-authoritative-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "check": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs && tsx --test tests/*.test.ts",
    "test:firebase-integration": "tsx --test tests/firebase-auth.integration.test.ts"
  },
  "dependencies": {
    "@colyseus/schema": "5.0.44",
    "colyseus": "0.18.10",
    "dotenv": "^16.4.7",
    "firebase-admin": "14.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
