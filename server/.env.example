# Local development uses the Firebase Emulator Suite only.
# Keep the project ID identical in the client, server and Firebase CLI command.
FIREBASE_PROJECT_ID=demo-tsi-local
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
PORT=2567
NODE_ENV=development

# Cloudinary values are supplied from the Cloudinary Console.
# Keep CLOUDINARY_API_SECRET private: this file is local and must never be committed.
# The media API remains disabled when all four values are empty.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
MEDIA_API_PORT=2568
MEDIA_API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
